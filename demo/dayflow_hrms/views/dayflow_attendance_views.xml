<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Attendance List / Tree View -->
        <record id="view_dayflow_attendance_tree" model="ir.ui.view">
            <field name="name">dayflow.attendance.tree</field>
            <field name="model">dayflow.attendance</field>
            <field name="arch" type="xml">
                <tree string="Attendances" sample="1" default_order="check_in desc">
                    <field name="attendance_date"/>
                    <field name="employee_id"/>
                    <field name="job_position" optional="show"/>
                    <field name="department" optional="show"/>
                    <field name="check_in"/>
                    <field name="check_out"/>
                    <field name="worked_hours" widget="float_time" sum="Total Worked Hours"/>
                    <field name="status"
                           widget="badge"
                           decoration-success="status == 'present'"
                           decoration-warning="status == 'late'"
                           decoration-info="status == 'half_day'"
                           decoration-danger="status == 'absent'"/>
                    <field name="notes" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </tree>
            </field>
        </record>

        <!-- Attendance Kanban View -->
        <record id="view_dayflow_attendance_kanban" model="ir.ui.view">
            <field name="name">dayflow.attendance.kanban</field>
            <field name="model">dayflow.attendance</field>
            <field name="arch" type="xml">
                <kanban sample="1" default_order="check_in desc">
                    <field name="id"/>
                    <field name="employee_id"/>
                    <field name="employee_image"/>
                    <field name="job_position"/>
                    <field name="department"/>
                    <field name="attendance_date"/>
                    <field name="check_in"/>
                    <field name="check_out"/>
                    <field name="worked_hours"/>
                    <field name="status"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill p-3">
                                <field name="employee_image" widget="image" class="o_kanban_image_fill_left" options="{'zoom': true, 'background': true, 'preventClicks': false}"/>
                                <div class="oe_kanban_details d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong class="o_kanban_record_title fs-6"><field name="employee_id"/></strong>
                                            <field name="status"
                                                   widget="badge"
                                                   decoration-success="status == 'present'"
                                                   decoration-warning="status == 'late'"
                                                   decoration-info="status == 'half_day'"
                                                   decoration-danger="status == 'absent'"/>
                                        </div>
                                        <div t-if="record.job_position.raw_value" class="text-muted small">
                                            <field name="job_position"/>
                                        </div>
                                        <div t-if="record.department.raw_value" class="text-muted small">
                                            <field name="department"/>
                                        </div>
                                    </div>
                                    <div class="mt-2 pt-2 border-top">
                                        <div class="d-flex justify-content-between small text-muted">
                                            <span><strong>In:</strong> <field name="check_in"/></span>
                                            <span t-if="record.check_out.raw_value"><strong>Out:</strong> <field name="check_out"/></span>
                                            <span t-else="" class="badge bg-primary text-white">In Progress</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-1 small">
                                            <span><field name="attendance_date"/></span>
                                            <span class="fw-bold text-dark"><field name="worked_hours" widget="float_time"/> hrs</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Attendance Form View -->
        <record id="view_dayflow_attendance_form" model="ir.ui.view">
            <field name="name">dayflow.attendance.form</field>
            <field name="model">dayflow.attendance</field>
            <field name="arch" type="xml">
                <form string="Attendance Record">
                    <header>
                        <button name="action_check_in"
                                string="Check In"
                                type="object"
                                class="oe_highlight btn-primary"
                                invisible="check_in and check_out"/>
                        <button name="action_check_out"
                                string="Check Out"
                                type="object"
                                class="oe_highlight btn-warning"
                                invisible="not check_in or check_out"/>
                        <field name="status" widget="statusbar" statusbar_visible="present,late,half_day,absent"/>
                    </header>
                    <sheet>
                        <field name="employee_image" widget="image" class="oe_avatar" options="{'preview_image': 'employee_image'}"/>
                        <div class="oe_title">
                            <label for="employee_id" class="oe_edit_only" string="Employee"/>
                            <h1>
                                <field name="employee_id" placeholder="Select Employee..."/>
                            </h1>
                            <div class="text-muted">
                                <field name="job_position" readonly="1" class="oe_inline"/>
                                <span invisible="not job_position or not department"> &amp;bull; </span>
                                <field name="department" readonly="1" class="oe_inline"/>
                            </div>
                        </div>
                        <group>
                            <group string="Attendance Session">
                                <field name="attendance_date"/>
                                <field name="check_in"/>
                                <field name="check_out"/>
                                <field name="worked_hours" widget="float_time"/>
                            </group>
                            <group string="Status &amp; Assignment">
                                <field name="status"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes &amp; Remarks" name="notes">
                                <field name="notes" placeholder="Add remarks, reasons for late arrival, early departure, or shift notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Attendance Search View -->
        <record id="view_dayflow_attendance_search" model="ir.ui.view">
            <field name="name">dayflow.attendance.search</field>
            <field name="model">dayflow.attendance</field>
            <field name="arch" type="xml">
                <search string="Search Attendances">
                    <field name="employee_id" string="Employee" filter_domain="['|', ('employee_id.name', 'ilike', self), ('employee_id.employee_id', 'ilike', self)]"/>
                    <field name="department"/>
                    <field name="job_position"/>
                    <field name="notes"/>

                    <!-- Date & Status Filters -->
                    <filter string="Today" name="filter_today" domain="[('attendance_date', '=', context_today())]"/>
                    <filter string="Active Check-ins" name="filter_active_checkins" domain="[('check_out', '=', False)]"/>
                    <separator/>
                    <filter string="Present" name="filter_present" domain="[('status', '=', 'present')]"/>
                    <filter string="Late" name="filter_late" domain="[('status', '=', 'late')]"/>
                    <filter string="Half Day" name="filter_half_day" domain="[('status', '=', 'half_day')]"/>
                    <filter string="Absent" name="filter_absent" domain="[('status', '=', 'absent')]"/>
                    <separator/>
                    <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>

                    <!-- Group By -->
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="group_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                        <filter string="Attendance Date" name="group_date" domain="[]" context="{'group_by': 'attendance_date'}"/>
                        <filter string="Status" name="group_status" domain="[]" context="{'group_by': 'status'}"/>
                        <filter string="Department" name="group_department" domain="[]" context="{'group_by': 'department'}"/>
                        <filter string="Company" name="group_company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action: All Attendance (HR / Admin) -->
        <record id="action_dayflow_attendance_all" model="ir.actions.act_window">
            <field name="name">All Attendance</field>
            <field name="res_model">dayflow.attendance</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="view_dayflow_attendance_search"/>
            <field name="context">{'search_default_filter_today': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Track and manage employee attendance logs!
                </p>
                <p>
                    View daily check-ins, check-outs, worked hours, and attendance states across the organization.
                </p>
            </field>
        </record>

        <!-- Action: My Attendance (Individual Employee) -->
        <record id="action_dayflow_attendance_my" model="ir.actions.act_window">
            <field name="name">My Attendance</field>
            <field name="res_model">dayflow.attendance</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="view_dayflow_attendance_search"/>
            <field name="domain">[('employee_id.user_id', '=', uid)]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No attendance records yet!
                </p>
                <p>
                    Check in to begin tracking your work hours for today.
                </p>
            </field>
        </record>

    </data>
</odoo>
