# ---------------------------------------------------------------------------
# Dayflow — local environment. NEVER COMMIT THIS FILE.
# Values come from Supabase Dashboard > Project Settings > API.
# ---------------------------------------------------------------------------

# Project URL. Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key. Safe in the browser: every query it makes is
# still filtered by the RLS policies in supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role / secret key. SERVER ONLY. BYPASSES RLS ENTIRELY.
# Used by scripts/create-auth-users.mjs and, from Phase 2, by the server
# action that creates employees. Never prefix it with NEXT_PUBLIC_ and never
# import it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
