{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // A separate clone of the team repo lives here and now holds its own copy
    // of the project. Its "@/*" paths resolve into OUR lib, so leaving it in
    // would fail our typecheck on files we do not own. Also gitignored.
    "Dayflow-Odoo-Hackathon-Virtual",
    // A snapshot copy of the app the repo owner committed in 9d253f2. Its
    // "@/*" paths resolve into OUR lib, so typechecking it reports errors on a
    // frozen duplicate rather than on the code we are editing.
    "phase-1-5-krithi_build"
  ]
}
