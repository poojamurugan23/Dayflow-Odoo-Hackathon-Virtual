<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Kanban View -->
        <record id="view_dayflow_employee_kanban" model="ir.ui.view">
            <field name="name">dayflow.employee.kanban</field>
            <field name="model">dayflow.employee</field>
            <field name="arch" type="xml">
                <kanban sample="1">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="job_position"/>
                    <field name="department"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="image_1920"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_dayflow_employee_kanban">
                                <field name="image_1920" widget="image" class="o_kanban_image_fill_left" options="{'zoom': true, 'background': true, 'preventClicks': false}"/>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="text-muted"><field name="employee_id"/></div>
                                    <div t-if="record.job_position.raw_value"><field name="job_position"/></div>
                                    <div t-if="record.department.raw_value" class="text-muted"><field name="department"/></div>
                                    <div t-if="record.email.raw_value"><a t-attf-href="mailto:#{record.email.raw_value}"><field name="email"/></a></div>
                                    <div t-if="record.phone.raw_value"><field name="phone"/></div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Tree / List View -->
        <record id="view_dayflow_employee_tree" model="ir.ui.view">
            <field name="name">dayflow.employee.tree</field>
            <field name="model">dayflow.employee</field>
            <field name="arch" type="xml">
                <tree string="Employees" sample="1">
                    <field name="employee_id"/>
                    <field name="name"/>
                    <field name="job_position"/>
                    <field name="department"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="joining_date"/>
                    <field name="user_id" optional="hide"/>
                    <field name="company_id" optional="hide"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_dayflow_employee_form" model="ir.ui.view">
            <field name="name">dayflow.employee.form</field>
            <field name="model">dayflow.employee</field>
            <field name="arch" type="xml">
                <form string="Employee">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_attendance"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-clock-o">
                                <field name="attendance_count" widget="statinfo" string="Attendances"/>
                            </button>
                        </div>
                        <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Employee Name"/>
                            <h1>
                                <field name="name" placeholder="e.g. John Doe"/>
                            </h1>
                            <h2>
                                <field name="employee_id" placeholder="Employee ID"/>
                            </h2>
                        </div>
                        <group>
                            <group string="Employment Details">
                                <field name="job_position" placeholder="e.g. Senior Software Engineer"/>
                                <field name="department" placeholder="e.g. Engineering"/>
                                <field name="joining_date"/>
                                <field name="attendance_state"
                                       widget="badge"
                                       decoration-success="attendance_state == 'checked_in'"
                                       decoration-muted="attendance_state == 'checked_out'"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group string="Contact Details">
                                <field name="email" widget="email" placeholder="e.g. john.doe@example.com"/>
                                <field name="phone" widget="phone" placeholder="e.g. +1 555-0199"/>
                                <field name="user_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_dayflow_employee_search" model="ir.ui.view">
            <field name="name">dayflow.employee.search</field>
            <field name="model">dayflow.employee</field>
            <field name="arch" type="xml">
                <search string="Search Employees">
                    <field name="name" string="Employee Name" filter_domain="['|', ('name', 'ilike', self), ('employee_id', 'ilike', self)]"/>
                    <field name="employee_id"/>
                    <field name="email"/>
                    <field name="department"/>
                    <field name="job_position"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Department" name="group_department" domain="[]" context="{'group_by': 'department'}"/>
                        <filter string="Job Position" name="group_job" domain="[]" context="{'group_by': 'job_position'}"/>
                        <filter string="Company" name="group_company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_dayflow_employee" model="ir.actions.act_window">
            <field name="name">Employees</field>
            <field name="res_model">dayflow.employee</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_dayflow_employee_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add your first employee to Dayflow HRMS!
                </p>
                <p>
                    Manage employee records, roles, contact details, and organization structure seamlessly.
                </p>
            </field>
        </record>

    </data>
</odoo>
