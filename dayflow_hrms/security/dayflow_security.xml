<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Category -->
        <record id="module_category_dayflow_hrms" model="ir.module.category">
            <field name="name">Dayflow HRMS</field>
            <field name="description">User access level for Dayflow Human Resource Management System</field>
            <field name="sequence">20</field>
        </record>

        <!-- Employee Security Group -->
        <record id="group_dayflow_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_dayflow_hrms"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Regular employee role with access strictly restricted to own profile.</field>
        </record>

        <!-- HR / Admin Security Group -->
        <record id="group_dayflow_admin" model="res.groups">
            <field name="name">HR / Admin</field>
            <field name="category_id" ref="module_category_dayflow_hrms"/>
            <field name="implied_ids" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">HR and Administrator role with full permissions to manage all employee records.</field>
        </record>
    </data>

    <!-- Record Rules -->
    <data noupdate="1">
        <!-- Rule 1: Employee can ONLY view/access their own employee record -->
        <record id="dayflow_employee_rule_own_record" model="ir.rule">
            <field name="name">Dayflow Employee: Own Record Only</field>
            <field name="model_id" ref="model_dayflow_employee"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule 2: HR / Admin has full access to all employee records -->
        <record id="dayflow_employee_rule_admin_all" model="ir.rule">
            <field name="name">Dayflow HR/Admin: All Records Access</field>
            <field name="model_id" ref="model_dayflow_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Rule 3: Employee can ONLY view/manage their own attendance records -->
        <record id="dayflow_attendance_rule_own_record" model="ir.rule">
            <field name="name">Dayflow Employee: Own Attendance Only</field>
            <field name="model_id" ref="model_dayflow_attendance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule 4: HR / Admin has full access to all attendance records -->
        <record id="dayflow_attendance_rule_admin_all" model="ir.rule">
            <field name="name">Dayflow HR/Admin: All Attendance Access</field>
            <field name="model_id" ref="model_dayflow_attendance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>

